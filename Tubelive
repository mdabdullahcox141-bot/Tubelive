<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>TubeLive - Login</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}
body{background:#f9f9f9;display:flex;justify-content:center;align-items:center;min-height:100vh}
.box{background:#fff;padding:30px;border-radius:15px;width:95%;max-width:400px;box-shadow:0 5px 20px rgba(0,0,0,0.1);text-align:center}
.logo{font-size:28px;font-weight:bold;margin-bottom:10px} .logo span{color:red}
h2{margin:15px 0 5px} p{color:#666;font-size:14px;margin-bottom:20px}
.btn{width:100%;padding:12px;margin:8px 0;border-radius:25px;border:1px solid #ddd;background:#fff;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;gap:10px}
.btn:hover{background:#f1f1f1}
.btn-red{background:red;color:#fff;border:none}
input{width:100%;padding:12px;margin:8px 0;border:1px solid #ddd;border-radius:25px;outline:none}
.lang{margin-top:15px;padding:8px 15px;border-radius:20px;border:1px solid #ddd}
</style>
</head>
<body>
<div class="box">
<div class="logo">🌍<span>Tube</span>Live</div>
<h2 id="t1">Welcome to TubeLive</h2>
<p id="t2">Unlimited World Videos - 100+ Languages</p>

<button class="btn" onclick="googleLogin()">🔵 Continue with Google</button>
<button class="btn" onclick="showPhone()">📱 Continue with Phone</button>

<div id="phoneBox" style="display:none">
<input id="phone" placeholder="Phone: +8801XXXXXXXXX">
<input id="otp" placeholder="OTP Code" style="display:none">
<button class="btn btn-red" id="phoneBtn" onclick="phoneLogin()">Send OTP</button>
</div>

<input id="email" placeholder="Email">
<input id="pass" type="password" placeholder="Password">
<button class="btn btn-red" onclick="emailLogin()">Login / Sign Up</button>

<button class="btn" onclick="guestLogin()">👤 Guest Mode - Watch Unlimited</button>

<select class="lang" id="lang" onchange="changeLang()">
<option value="en">🌐 English</option>
<option value="bn">🇧🇩 বাংলা</option>
<option value="hi">🇮🇳 Hindi</option>
<option value="ar">🇸🇦 Arabic</option>
<option value="es">🇪🇸 Spanish</option>
<option value="fr">🇫🇷 French</option>
<option value="ur">🇵🇰 Urdu</option>
<option value="pt">🇧🇷 Portuguese</option>
</select>

<p style="margin-top:15px;font-size:12px">195 Countries • 100+ Languages • Unlimited Users</p>
</div>

<script>
// Language Change
function changeLang(){
let v=document.getElementById('lang').value;
if(v=='bn'){document.getElementById('t1').innerText="TubeLive এ স্বাগতম";document.getElementById('t2').innerText="আনলিমিটেড ভিডিও - ১০০+ ভাষা"}
else if(v=='hi'){document.getElementById('t1').innerText="TubeLive में स्वागत है";document.getElementById('t2').innerText="अनलिमिटेड वीडियो - 100+ भाषा"}
else{document.getElementById('t1').innerText="Welcome to TubeLive";document.getElementById('t2').innerText="Unlimited World Videos - 100+ Languages"}
}

// Login Functions - Firebase will be added in next step
function googleLogin(){alert('Google Login - Firebase Connect করলেই কাজ করবে! এখন Guest Mode ব্যবহার করো'); guestLogin()}
function showPhone(){document.getElementById('phoneBox').style.display='block'}
function phoneLogin(){
let b=document.getElementById('phoneBtn');
if(b.innerText=='Send OTP'){b.innerText='Verify OTP';document.getElementById('otp').style.display='block';alert('OTP: 123456 (Demo)')}
else{guestLogin()}
}
function emailLogin(){guestLogin()}
function guestLogin(){
localStorage.setItem('tubelive_user','guest_'+Date.now());
window.location.href='./index2.html';
}
</script>
</body>
</html>
